# ---- LLM ------------------------------------------------------------
# Provider: ollama (default, offline-first) | openai | anthropic | groq | nvidia
LLM_PROVIDER=ollama
LLM_MODEL=phi4-mini-localbrain
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=256

# ---- Embeddings ------------------------------------------------------
# Provider: ollama (default) | openai | huggingface
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# ---- Vault -----------------------------------------------------------
# Root of the Obsidian-style markdown vault to index
VAULT_PATH=./vaults/sample

# ---- ChromaDB --------------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=localbrain

# ---- Chunking --------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ---- Retrieval -------------------------------------------------------
# similarity | mmr
SEARCH_TYPE=mmr
TOP_K=5
MMR_FETCH_K=15
SIMILARITY_THRESHOLD=0.70

# ---- Agent loop ------------------------------------------------------
# Route simple factual queries straight to retrieve→generate (skip grade/rewrite/reflect).
FASTPATH_ENABLED=true
# Context compression budget — retrieved context above this char count is trimmed.
CONTEXT_MAX_CHARS=6000

# ---- Web search tool --------------------------------------------------
# Live web search (DuckDuckGo HTML, no key) for "tool" questions. Disable to run offline.
WEB_SEARCH_ENABLED=true

# ---- Memory ----------------------------------------------------------
MEMORY_WINDOW_SIZE=10

# ---- Ollama ----------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# ---- API keys (cloud upgrade path — only needed for cloud providers) --
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# ---- RAGAS eval judge ------------------------------------------------
# Judge backend used to score answers: "ollama" (local, consistent) or
# "openai" (any /v1 endpoint below).
EVAL_JUDGE_PROVIDER=ollama
# Which model the judge uses for faithfulness / relevancy grading.
EVAL_LLM_MODEL=phi4-mini-localbrain
# For provider=ollama, point at the local Ollama /v1 shim:
EVAL_LLM_BASE_URL=http://localhost:11434/v1
# Any non-empty key works for local Ollama; cloud keys go here too
# (OpenRouter: https://openrouter.ai/api/v1, NVIDIA NIM: .../v1).
EVAL_LLM_API_KEY=ollama
